# Have I Been Pwned API v3 key (required by the email_breach collector).
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# GitHub personal access token (optional; raises the unauthenticated rate limit
# for the github collector). Needs no scopes for public data.
GITHUB_TOKEN=

# User-Agent header sent on every outbound request. Some APIs (HIBP) reject
# generic or missing user agents.
FOOTPRINT_RECON_USER_AGENT=footprint-recon/0.1 (self-osint tool)
